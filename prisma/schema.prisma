// Prisma Schema for SGM Mart (E-Commerce & 16-Income MLM Platform)
// Compliant with Indian Direct Selling Rules 2021

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. STEALTH SUPERADMIN ARCHITECTURE
// (Completely isolated table; unseen by Admins)
// ==========================================
model SystemMaster {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  stealthRole   String    @default("SUPER_ROOT")
  ipWhitelist   String?
  mfaSecret     String?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("system_masters")
}

// ==========================================
// 2. OPERATIONAL ADMINS (Staff Roles)
// (Admins only see other staff admins)
// ==========================================
enum AdminRole {
  GENERAL_ADMIN
  KYC_MANAGER
  CATALOG_MANAGER
  ORDER_DISPATCHER
  FINANCE_OFFICER
  SUPPORT_AGENT
}

model Admin {
  id            String      @id @default(uuid())
  username      String      @unique
  email         String      @unique
  fullName      String
  passwordHash  String
  role          AdminRole   @default(GENERAL_ADMIN)
  permissions   Json?       // Granular RBAC permissions
  isActive      Boolean     @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  auditLogs     AdminAuditLog[]
  kycReviewed   KYCDetail[]

  @@map("admins")
}

// ==========================================
// 3. USERS / DISTRIBUTORS / CUSTOMERS
// ==========================================
enum RankDesignation {
  DISTRIBUTOR
  STAR_1
  STAR_2
  STAR_3
  SILVER
  GOLD
  RUBY
  PLATINUM
  EMERALD
  DIAMOND
  DOUBLE_DIAMOND
  TRIPLE_DIAMOND
  KOHINOOR
  AMBASSADOR
  ROYAL_AMBASSADOR
  CROWN_AMBASSADOR
}

enum BinaryPosition {
  LEFT
  RIGHT
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String           @id @default(uuid())
  userCode            String           @unique // e.g. SGM10001
  name                String
  email               String?
  mobile              String
  pan                 String?
  passwordHash        String
  
  // Binary & Sponsor Relationships
  sponsorId           String?
  sponsor             User?            @relation("SponsorReferrals", fields: [sponsorId], references: [id])
  directReferrals     User[]           @relation("SponsorReferrals")
  
  placementParentId   String?
  placementParent     User?            @relation("BinaryPlacements", fields: [placementParentId], references: [id])
  binaryChildren      User[]           @relation("BinaryPlacements")
  placementPosition   BinaryPosition?

  // Business Performance Metrics
  rank                RankDesignation  @default(DISTRIBUTOR)
  isActive            Boolean          @default(false)
  activatedAt         DateTime?
  
  leftVolumePV        Float            @default(0)
  rightVolumePV       Float            @default(0)
  leftCarryForwardPV  Float            @default(0)
  rightCarryForwardPV Float            @default(0)
  totalMatchingPaidPV Float            @default(0)
  directBusinessPV    Float            @default(0) // For 3000 PV Leadership & 5000 PV CTO qualification
  rewardPointsRP      Float            @default(0)

  // System & Financial
  wallet              Wallet?
  kycDetail           KYCDetail?
  orders              Order[]
  autoPoolMemberships AutoPoolEntry[]
  utilityRecharges    UtilityRecharge[]
  withdrawalRequests  WithdrawalRequest[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([sponsorId])
  @@index([placementParentId])
  @@index([userCode])
  @@index([mobile])
  @@index([email])
  @@index([pan])
  @@map("users")
}

// ==========================================
// 4. KYC & BANK DETAILS
// ==========================================
model KYCDetail {
  id                  String     @id @default(uuid())
  userId              String     @unique
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  panNumber           String
  panPhotoUrl         String?
  aadhaarNumber       String
  aadhaarFrontUrl     String?
  aadhaarBackUrl      String?

  bankName            String
  bankAccountNumber   String
  ifscCode            String
  accountHolderName   String
  passbookChequeUrl   String?

  status              KYCStatus  @default(PENDING)
  rejectionReason     String?
  
  reviewedByAdminId   String?
  reviewedBy          Admin?     @relation(fields: [reviewedByAdminId], references: [id])
  reviewedAt          DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([panNumber])
  @@index([aadhaarNumber])
  @@map("kyc_details")
}

// ==========================================
// 5. E-COMMERCE PRODUCTS & PACKAGES
// ==========================================
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id              String      @id @default(uuid())
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  
  title           String
  slug            String      @unique
  description     String
  mrp             Float       // Maximum Retail Price
  dpPrice         Float       // Distributor Price
  pv              Float       // Point Value (Activation & Matching)
  bv              Float       // Business Value (Repurchase Cashback)
  stockQuantity   Int         @default(0)
  images          String[]
  isActivation    Boolean     @default(false)
  isActive        Boolean     @default(true)
  
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("products")
}

// ==========================================
// 6. ORDERS & INVOICES
// ==========================================
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // SGM-ORD-10001
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  totalMrp        Float
  totalDp         Float
  totalDiscount   Float
  deliveryFee     Float         @default(0)
  totalPV         Float         @default(0)
  totalBV         Float         @default(0)
  
  orderStatus     OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String        @default("ONLINE") // RAZORPAY, CASHFREE, WALLET
  paymentTxId     String?

  shippingAddress Json
  invoiceUrl      String?
  isActivation    Boolean       @default(false)
  targetUserCode  String?       // Populated when package bought for another member
  notes           String?

  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  quantity    Int
  unitMrp     Float
  unitDp      Float
  unitPV      Float
  unitBV      Float

  @@map("order_items")
}

// ==========================================
// 7. AUTO POOL (7-LEVEL 2x2 GLOBAL MATRIX)
// ==========================================
model AutoPoolEntry {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  
  poolLevel       Int             @default(1) // Levels 1 to 7
  parentPoolId    String?
  parentPool      AutoPoolEntry?  @relation("AutoPoolTree", fields: [parentPoolId], references: [id])
  children        AutoPoolEntry[] @relation("AutoPoolTree")
  childPosition   Int?            // 1 (Left) or 2 (Right)

  grossAmount     Float           @default(0)
  upgradeDeducted Float           @default(0)
  netPaidOut      Float           @default(0)
  isCompleted     Boolean         @default(false)
  completedAt     DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([poolLevel, isCompleted])
  @@map("autopool_entries")
}

// ==========================================
// 8. MULTI-WALLET & LEDGER ENGINE
// ==========================================
model Wallet {
  id                  String              @id @default(uuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  mainBalance         Float               @default(0) // Available for withdrawal
  p2pBalance          Float               @default(0) // P2P wallet for fund transfers and activations
  shoppingBalance     Float               @default(0) // Repurchase & Utility balance
  holdBalance         Float               @default(0) // Pending KYC or verification
  autoPoolReserve     Float               @default(0) // Level upgrade deductions reserve

  totalEarned         Float               @default(0)
  totalWithdrawn      Float               @default(0)

  transactions        WalletTransaction[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("wallets")
}

enum TransactionType {
  RETAIL_PROFIT
  DIRECT_REFERRAL
  BINARY_MATCHING
  SPONSOR_ROYALTY
  AWARD_REWARD
  LEADERSHIP_CTO
  COMPANY_CTO
  AUTOPOOL_INCOME
  PURCHASE_CASHBACK
  REPURCHASE_TEAM
  MOBILE_FUND
  BIKE_FUND
  CAR_FUND
  HOUSE_FUND
  MOBILE_RECHARGE_CASHBACK
  DTH_RECHARGE_CASHBACK
  WITHDRAWAL_REQUEST
  WITHDRAWAL_ADMIN_FEE
  WITHDRAWAL_TDS
  WALLET_PURCHASE
  SYSTEM_CREDIT
  SYSTEM_DEBIT
  P2P_TRANSFER_SENT
  P2P_TRANSFER_RECEIVED
  MAIN_TO_P2P_TRANSFER
  PACKAGE_ACTIVATION_SELF
  PACKAGE_ACTIVATION_OTHER
}

model WalletTransaction {
  id                    String          @id @default(uuid())
  walletId              String
  wallet                Wallet          @relation(fields: [walletId], references: [id])
  
  type                  TransactionType
  walletScope           String          @default("MAIN") // MAIN, P2P, SHOPPING
  amount                Float           // Positive for credit, negative for debit
  closingBalance        Float
  counterpartyUserCode  String?         // Sender/Recipient member ID for P2P transfers/activations
  counterpartyName      String?         // Sender/Recipient member name
  referenceId           String?         // OrderId, WithdrawalId, AutoPoolId, P2P Transfer ID
  remarks               String?

  createdAt             DateTime        @default(now())

  @@index([walletId, type])
  @@index([walletId, walletScope])
  @@map("wallet_transactions")
}

// ==========================================
// 9. WITHDRAWAL SETTLEMENTS & DEDUCTIONS
// ==========================================
enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model WithdrawalRequest {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])

  requestedAmount Float             // Min ₹100
  adminCharge     Float             // 5%
  tdsAmount       Float             // 5%
  netPayable      Float             // 90%
  
  bankSnapshot    Json              // Frozen snapshot of bank details at request time
  status          WithdrawalStatus  @default(PENDING)
  rejectionReason String?
  paymentTxId     String?           // UTR / IMPS / NEFT ref
  paidAt          DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("withdrawal_requests")
}

// ==========================================
// 10. UTILITY RECHARGES (Mobile & DTH)
// ==========================================
enum ServiceType {
  MOBILE_RECHARGE
  DTH_RECHARGE
}

model UtilityRecharge {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])

  serviceType     ServiceType
  operatorName    String
  circleOrRegion  String?
  targetNumber    String      // Phone or DTH Subscriber ID
  rechargeAmount  Float
  cashbackEarned  Float       // 2.50%
  status          String      @default("SUCCESS")
  operatorTxId    String?

  createdAt       DateTime    @default(now())

  @@map("utility_recharges")
}

// ==========================================
// 11. AUDIT LOGS (Admin activity tracking)
// ==========================================
model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id])
  action      String
  targetEntity String
  targetId    String?
  ipAddress   String?
  changes     Json?
  createdAt   DateTime @default(now())

  @@map("admin_audit_logs")
}

// ==========================================
// 12. GALLERY ITEMS (Photos & Company Events)
// ==========================================
model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  caption     String?
  imageUrl    String
  category    String   @default("EVENT") // EVENT, AWARD, PRODUCT, SEMINAR, OFFICE
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery_items")
}

// ==========================================
// 13. SYSTEM SETTINGS & PLAN CONFIGURATION
// ==========================================
model SystemSetting {
  id                      String   @id @default("default_setting")

  // MLM Plan Configuration
  planName                String   @default("SGM Mart 16-Income Plan")
  minActivationPV         Float    @default(100)
  directSponsorBonus      Float    @default(50)
  binaryMatchingPercent   Float    @default(10)
  dailyMatchingCappingPV  Float    @default(2500)
  adminChargePercent      Float    @default(5)
  tdsPercent              Float    @default(5)
  minWithdrawalAmount     Float    @default(100)
  p2pTransferFeePercent   Float    @default(0)
  rechargeCashbackPercent Float    @default(2.5)
  leadershipCTOPercent    Float    @default(5)
  companyCTOPercent       Float    @default(5)
  autoPoolEnabled         Boolean  @default(true)

  // Admin Notice & Ticker Announcement
  noticeEnabled           Boolean  @default(true)
  noticeType              String   @default("INFO") // INFO, WARNING, SUCCESS, DANGER
  noticeTitle             String   @default("महत्वपूर्ण सूचना (Important Announcement)")
  noticeText              String   @default("SGM Mart परिवार में आपका स्वागत है! सभी सदस्य अपनी KYC समय पर पूर्ण कर लें एवं वीकली पेआउट प्राप्त करें।")
  noticeLink              String?  @default("")

  // Global Popup Modal
  popupEnabled            Boolean  @default(false)
  popupTitle              String   @default("विशेष सूचना एवं बंपर ऑफर")
  popupContent            String   @default("SGM Mart में बंपर ऑफर! नए सदस्यों को डायरेक्ट रेफरल पर विशेष उपहार एवं 16 प्रकार की महा इनकम का लाभ तुरंत उठाएं।")
  popupImageUrl           String?  @default("")
  popupButtonText         String   @default("अभी देखें (Explore Now)")
  popupButtonLink         String   @default("/store")
  popupTarget             String   @default("ALL") // ALL, MEMBERS, GUESTS

  // General Portal & Operations
  companyName             String   @default("SGM Mart Online Service Pvt. Ltd.")
  supportPhone            String   @default("+91 9876543210")
  supportEmail            String   @default("support@sgmmart.com")
  supportWhatsApp         String   @default("+91 9876543210")
  supportAddress          String   @default("Corporate Office, Business Park, India")
  registrationEnabled     Boolean  @default(true)
  withdrawalsEnabled      Boolean  @default(true)
  maintenanceMode         Boolean  @default(false)
  maintenanceMessage      String?  @default("पोर्टल में आवश्यक तकनीकी सुधार कार्य प्रगति पर है। कृपया कुछ समय बाद पुनः प्रयास करें।")

  // Google Drive Auto-Upload Configuration
  googleDriveUploadUrl    String?  @default("")
  googleDriveFolderId     String?  @default("1m48lvsU628rR8nhL4i-24GWdJe_4w5Hn")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("system_settings")
}


